#pragma once

// Optional fallback Wi-Fi credentials. Normally the clock is connected with WPS
// (long press -> Settings -> Connect Wi-Fi (WPS), then press the router's WPS
// button); those credentials are stored on the device and take precedence.
// Copy this file to include/secrets.h to use it. include/secrets.h is git-ignored.
#define WIFI_SSID "your-wifi-name"
#define WIFI_PASSWORD "your-wifi-password"
